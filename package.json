{
  "name": "alertas-clima",
  "version": "1.0.0",
  "private": true,
  "description": "Monitora posts de avisos meteorológicos e notifica só para as localizações definidas",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "login:instagram": "tsx src/login.ts",
