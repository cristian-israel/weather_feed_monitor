# Perfil do Instagram a monitorar (sem @)
PERFIL=nome_da_conta

# Fonte de posts: playwright | mock
FONTE=playwright

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase (use a service_role key, somente no backend)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Arquivos de localização
LOCAIS_PATH=locais.json
CATALOGO_PATH=data/catalogo.json
APELIDOS_PATH=data/apelidos.json

# Agendamento (usado por `pnpm agendar`)
# Captura de posts: padrão = a cada 20 minutos
CRON=*/20 * * * *
# Lembrete diário (tempo desde o último alerta de cada município): padrão = 09:00
# Use "off" para desligar
CRON_LEMBRETE=0 9 * * *
# Para de lembrar quando passar deste número de dias sem novo alerta
MAX_DIAS_LEMBRETE=7
TZ_AGENDA=America/Sao_Paulo
# Executa uma rodada de captura imediatamente ao iniciar o agendador
RODAR_AO_INICIAR=true

# Arquivo com a sessão do Instagram salva pelo `pnpm login:instagram`
SESSAO_PATH=sessao.json

# Máximo de imagens enviadas por post
MAX_IMAGENS=4
